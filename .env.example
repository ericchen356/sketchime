# Gemini API key. Preferred over the in-app settings dialog: set here and the
# key never reaches the browser at all.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model overrides.
# Keyframe interpolation (a start AND an end image) needs a Veo model that
# accepts `lastFrame` — Veo 3.1 or later.
# GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
# GEMINI_TEXT_MODEL=gemini-2.5-flash
